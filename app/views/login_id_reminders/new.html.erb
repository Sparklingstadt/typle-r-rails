<% content_for :bare_title, tt("auth.forgotId.title") %>
<%= page_main(width: :narrow) do %>
  <%= page_header tt("auth.forgotId.title"), tt("auth.forgotId.description") %>
  <%= form_with url: login_id_reminder_path, class: "max-w-sm space-y-4", data: { controller: "filled", action: "input->filled#update change->filled#update" } do |f| %>
    <%= settings_field tt("auth.fields.email"), id: "reminder-email" do |id| %>
      <%= f.email_field :email, id:, required: true, autofocus: true, autocomplete: "email", autocapitalize: "none", spellcheck: false, value: params[:email], class: settings_input_classes %>
    <% end %>
    <%= f.button tt("auth.send"), type: "submit", class: button_classes(size: :lg), data: { filled_target: "submit" } %>
    <% if @sent %><%= form_message(tt("auth.forgotId.sent")) %><% end %>
    <p class="text-sm"><%= link_to tt("auth.backToSignIn"), new_session_path, class: SettingsDesignHelper::SETTINGS_LINK %></p>
  <% end %>
<% end %>
