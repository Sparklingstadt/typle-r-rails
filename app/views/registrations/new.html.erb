<% content_for :bare_title, tt("auth.signUp.title") %>
<%= page_main(width: :narrow) do %>
  <%= page_header tt("auth.signUp.title"), tt("auth.signUp.description") %>
  <div class="max-w-sm space-y-6">
    <%= form_with model: @user, url: registration_path, class: "space-y-4", html: { novalidate: true } do |f| %>
      <%= hidden_field_tag :returnTo, return_to, id: nil %>
      <%= settings_field tt("auth.fields.loginId"), id: "signup-login-id", hint: tt("auth.fields.loginIdHint"), error: signup_problem(@user, :login_id) do |id| %>
        <%= f.text_field :login_id, id:, required: true, autofocus: true, autocomplete: "username", autocapitalize: "none", spellcheck: false, minlength: 3, maxlength: 32, class: settings_input_classes, "aria-invalid": (@user.errors[:login_id].any? || nil) %>
      <% end %>
      <%= settings_field tt("auth.fields.email"), id: "signup-email", hint: tt("auth.fields.emailHint"), error: signup_problem(@user, :email) do |id| %>
        <%= f.email_field :email, id:, autocomplete: "email", autocapitalize: "none", spellcheck: false, class: settings_input_classes, "aria-invalid": (@user.errors[:email].any? || nil) %>
      <% end %>
      <%= settings_field tt("auth.fields.password"), id: "signup-password", hint: password_hint, error: signup_problem(@user, :password) do |id| %>
        <%= f.password_field :password, id:, required: true, autocomplete: "new-password", minlength: 10, maxlength: 72, class: settings_input_classes, "aria-invalid": (@user.errors[:password].any? || nil) %>
      <% end %>
      <%= f.button settings_t("auth.signUp.submit"), type: "submit", class: button_classes(size: :lg) %>
      <p class="text-sm"><%= link_to settings_t("auth.signUp.haveAccount"), new_session_path(returnTo: return_to), class: SettingsDesignHelper::SETTINGS_LINK %></p>
    <% end %>
  </div>
<% end %>
