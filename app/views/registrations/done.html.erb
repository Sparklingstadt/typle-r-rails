<%# typle-r's sign-up when it is done: signed in, and whether the mail that confirms the address went out. %>
<% content_for :bare_title, tt("auth.signUp.title") %>
<%= page_main(width: :narrow) do %>
  <%= page_header tt("auth.signUp.title"), tt("auth.signUp.description") %>
  <div class="max-w-sm space-y-4">
    <%= form_message(tt("auth.signUp.done")) %>
    <p class="text-sm"><%= @user.email ? tt("auth.signUp.mailSent", email: @user.email) : tt("auth.signUp.mailNotSent") %></p>
    <%= link_button tt("auth.signUp.continue"), return_to, size: :lg %>
  </div>
<% end %>
