<%# StorageSection. A guest's data is kept on the server for this browser (a cookie), not in LocalStorage, so those
    points are the app's own; there is no migration from v0.1.x and no check for changes made in other windows. %>
<%= guide_section("storage", "hard-drive", guide_t("contents.storage"), guide_t("storage.lead")) do %>
  <div class="grid gap-3 sm:grid-cols-2">
    <% [["hard-drive", "browser", [guide_t("storage.browser.p1"), guide_own("storage.browser.p2")]],
        [:cloud, "account", [guide_t("storage.account.p1"), guide_t("storage.account.p2")]]].each do |icon_name, place, points| %>
      <div class="rounded-xl border bg-card p-4">
        <div class="flex items-center gap-3">
          <span class="grid size-9 shrink-0 place-items-center rounded-full bg-muted text-muted-foreground"><%= icon(icon_name) %></span>
          <div>
            <h3 class="text-[15px] font-bold leading-6"><%= guide_t("storage.#{place}.title") %></h3>
            <p class="text-xs text-muted-foreground"><%= guide_t("storage.#{place}.when") %></p>
          </div>
        </div>
        <ul class="mt-3 list-disc space-y-1 pl-5 text-sm leading-6 marker:text-muted-foreground/60"><% points.each do |point| %><li><%= point %></li><% end %></ul>
      </div>
    <% end %>
  </div>
  <div class="flex gap-3 rounded-xl border border-amber-200 bg-amber-50 p-4 text-amber-950 dark:border-amber-900/60 dark:bg-amber-950/40 dark:text-amber-100">
    <%= icon("triangle-alert", class: "mt-1 size-4 shrink-0 text-amber-600 dark:text-amber-400") %>
    <div>
      <h3 class="text-[15px] font-bold leading-6"><%= guide_t("storage.warning.title") %></h3>
      <ul class="mt-1 list-disc space-y-1 pl-5 text-sm leading-6 marker:text-amber-600/60">
        <li><%= guide_own("storage.warning.p1") %></li>
        <li><%= guide_t("storage.warning.p2") %></li>
      </ul>
    </div>
  </div>
  <%= guide_points(guide_t("storage.notes.p1")) %>
<% end %>
