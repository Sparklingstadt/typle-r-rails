<%# PracticeSection. Where typle-r's text describes what this app does differently, the point is the app's own
    (design.guide.practice.*); a point about something it does not have (a confirmation when switching lists) is left out. %>
<%= guide_section("practice", :keyboard, guide_t("contents.practice"), guide_rich(guide_t("practice.lead"))) do %>
  <%= guide_topic(guide_t("practice.colors.title")) do %>
    <%= guide_color_legend %>
    <p class="mt-3"><%= guide_rich(guide_t("practice.colors.text")) %></p>
  <% end %>
  <%= guide_topic(guide_t("practice.flow.title")) do %>
    <%= guide_points(guide_t("practice.flow.p1"), guide_t("practice.flow.p2"), guide_t("practice.flow.p3"), guide_t("practice.flow.p4"),
          guide_t("practice.flow.p5"), guide_rich(guide_t("practice.flow.p6"))) %>
  <% end %>
  <%= guide_topic(guide_t("practice.choose.title")) do %>
    <%= guide_points(guide_own("practice.choose.p1"), guide_rich(guide_t("practice.choose.p3")), guide_rich(guide_t("practice.choose.p4"))) %>
  <% end %>
  <%= guide_topic(guide_t("practice.writing.title")) do %>
    <%= guide_points(guide_t("practice.writing.p1"), guide_own("practice.writing.p2"), guide_rich(guide_t("practice.writing.p3")), guide_own("practice.writing.p4")) %>
  <% end %>
<% end %>
