<%# typle-r TrendChart (Dashboard): the time of the latest runs on a 0–100 viewBox stretched to the box, the latest run
    marked; the trend-chart controller reads each run out by pointer and arrow keys. %>
<% scale = records_speed_scale(points.map(&:seconds)) %>
<% low, high = scale[:domain] %>
<% last = points.size - 1 %>
<% x = ->(index) { (index * 100.0 / last).round(3) } %>
<% y = ->(value) { ((1 - (value - low) / (high - low)) * 100).round(3) } %>
<% line = points.each_with_index.map { |point, index| "#{index.zero? ? "M" : "L"}#{x.(index)} #{y.(point.seconds)}" }.join(" ") %>
<figure class="flex flex-col gap-1">
  <div class="flex gap-1.5">
    <div aria-hidden="true" class="relative my-2 w-8 shrink-0 text-[11px] text-muted-foreground tabular-nums">
      <% scale[:ticks].each do |tick| %>
        <span class="absolute right-0 -translate-y-1/2 leading-none" style="top: <%= y.(tick) %>%"><%= format("%.#{scale[:decimals]}f", tick) %></span>
      <% end %>
    </div>
    <% latest_text = "#{records_short_date(points.last.practiced_at)} #{records_clock(points.last.practiced_at)} #{records_time_text(points.last.seconds)}" %>
    <%= tag.div class: "relative h-[72px] min-w-0 flex-1 cursor-crosshair touch-pan-y rounded-sm py-2 outline-none focus-visible:ring-3 focus-visible:ring-ring/50", role: "slider", tabindex: 0,
          "aria-label": records_t("chart.label", label:), "aria-valuemin": 1, "aria-valuemax": points.size, "aria-valuenow": points.size, "aria-valuetext": latest_text,
          data: { controller: "trend-chart", action: "focus->trend-chart#focus blur->trend-chart#blur pointermove->trend-chart#point pointerdown->trend-chart#point pointerleave->trend-chart#leave keydown->trend-chart#key",
                  trend_chart_points_value: points.each_with_index.map { |point, index| { x: x.(index), y: y.(point.seconds), value: records_time_text(point.seconds), date: "#{records_short_date(point.practiced_at)} #{records_clock(point.practiced_at)}" } }.to_json } do %>
      <div class="relative mx-1 h-full">
        <svg aria-hidden="true" viewBox="0 0 100 100" preserveAspectRatio="none" class="absolute inset-0 size-full overflow-visible">
          <% scale[:ticks].each do |tick| %>
            <line x1="0" x2="100" y1="<%= y.(tick) %>" y2="<%= y.(tick) %>" class="stroke-border" stroke-width="1" vector-effect="non-scaling-stroke" />
          <% end %>
          <path d="<%= line %> L<%= x.(last) %> 100 L0 100 Z" class="fill-trend/10" />
          <path d="<%= line %>" class="stroke-trend" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
          <line x1="0" x2="0" y1="0" y2="100" class="stroke-muted-foreground/60" stroke-width="1" vector-effect="non-scaling-stroke" style="display: none" data-trend-chart-target="cursor" />
        </svg>
        <span aria-hidden="true" class="absolute size-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-trend ring-2 ring-card" style="left: <%= x.(last) %>%; top: <%= y.(points[last].seconds) %>%" data-trend-chart-target="dot"></span>
        <%= trend_chart_tooltip %>
      </div>
    <% end %>
  </div>
  <figcaption aria-hidden="true" class="flex justify-between pl-10 text-[11px] text-muted-foreground tabular-nums">
    <span><%= records_short_date(points.first.practiced_at) %></span><span><%= records_short_date(points.last.practiced_at) %></span>
  </figcaption>
  <table class="sr-only">
    <caption><%= label %></caption>
    <thead><tr><th scope="col"><%= records_t("chart.date") %></th><th scope="col"><%= records_t("chart.value") %></th></tr></thead>
    <tbody>
      <% points.each do |point| %>
        <tr><td><%= "#{records_short_date(point.practiced_at)} #{records_clock(point.practiced_at)}" %></td><td><%= records_time_text(point.seconds) %></td></tr>
      <% end %>
    </tbody>
  </table>
</figure>
