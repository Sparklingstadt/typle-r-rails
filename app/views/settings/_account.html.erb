<%# typle-r's SessionSettings: signing out of every device. (Its account section of the ID-and-password login was
    removed with that login in v2.59.0.) %>
<%= settings_section(icon: "monitor-smartphone", id: "sessions", title: tt("settings.sessions.heading"), description: tt("settings.sessions.description")) do %>
  <div class="mt-4 sm:pl-14">
    <%= form_button tt("settings.sessions.action"), sessions_account_path, method: :delete, variant: :outline,
          form: { data: confirm_data(title: tt("settings.sessions.confirmTitle"), description: tt("settings.sessions.confirmDescription"), action: tt("settings.sessions.confirm")) } %>
  </div>
<% end %>
