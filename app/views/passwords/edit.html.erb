<% content_for :bare_title, tt("auth.resetPassword.title") %>
<%= page_main(width: :narrow) do %>
  <%= page_header tt("auth.resetPassword.title"), tt("auth.resetPassword.description") %>
  <%= form_with url: password_path(token: params[:token]), method: :put, class: "max-w-sm space-y-4" do |f| %>
    <%= settings_errors(@user) %>
    <%= settings_field tt("auth.fields.newPassword"), id: "new-password", hint: password_hint do |id| %>
      <%= f.password_field :password, id:, required: true, autofocus: true, autocomplete: "new-password", maxlength: 72, class: settings_input_classes, "aria-describedby": "#{id}-hint" %>
    <% end %>
    <%= f.button tt("auth.resetPassword.submit"), type: "submit", class: button_classes(size: :lg) %>
    <% if @user.errors.any? %><p class="text-sm"><%= link_to tt("auth.resetPassword.again"), new_password_path, class: SettingsDesignHelper::SETTINGS_LINK %></p><% end %>
  <% end %>
<% end %>
