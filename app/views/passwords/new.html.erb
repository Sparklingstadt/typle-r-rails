<% content_for :bare_title, tt("auth.forgotPassword.title") %>
<%= page_main(width: :narrow) do %>
  <%= page_header tt("auth.forgotPassword.title"), tt("auth.forgotPassword.description") %>
  <%= form_with url: passwords_path, class: "max-w-sm space-y-4", data: { controller: "filled", action: "input->filled#update change->filled#update" } do |f| %>
    <%= settings_field tt("auth.fields.loginId"), id: "reset-login-id" do |id| %>
      <%= f.text_field :login_id, id:, required: true, autofocus: true, autocomplete: "username", autocapitalize: "none", spellcheck: false, value: params[:login_id], class: settings_input_classes %>
    <% end %>
    <%= f.button tt("auth.send"), type: "submit", class: button_classes(size: :lg), data: { filled_target: "submit" } %>
    <% if @sent %><%= form_message(tt("auth.forgotPassword.sent")) %><% end %>
    <p class="text-sm"><%= link_to tt("auth.signIn.forgotId"), new_login_id_reminder_path, class: SettingsDesignHelper::SETTINGS_LINK %></p>
    <p class="text-sm"><%= link_to tt("auth.backToSignIn"), new_session_path, class: SettingsDesignHelper::SETTINGS_LINK %></p>
  <% end %>
<% end %>
